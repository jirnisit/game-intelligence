{
  "name": "@game-intelligence/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "check": "vue-tsc --noEmit && pnpm lint",
    "test": "vitest run --environment happy-dom",
